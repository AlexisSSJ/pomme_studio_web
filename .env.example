# ---------------------------------------------------------------------------
# Pomme Studio — Example environment configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust the values for your local environment:
#   cp .env.example .env
#
# NEVER commit real secrets. `.env` is git-ignored; this example contains only
# safe development placeholders. Generate strong values before deploying.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Environment / Application
# ---------------------------------------------------------------------------
# Deployment stage. One of: development | staging | production
ENVIRONMENT=development
# Enable verbose debug output and interactive API docs. MUST be false in prod.
DEBUG=true
# Secret used to sign JWTs and other cryptographic material.
# Generate a strong value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-in-production
# Comma-separated browser origins allowed by CORS (frontend dev servers).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# Individual connection parts are useful for tooling (psql, alembic, docker).
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=pomme_user
POSTGRES_PASSWORD=pomme_password
POSTGRES_DB=pomme_studio
# SQLAlchemy async connection string used by the application (asyncpg driver).
# Keep in sync with the POSTGRES_* values above.
DATABASE_URL=postgresql+asyncpg://pomme_user:pomme_password@localhost:5432/pomme_studio

# ---------------------------------------------------------------------------
# Auth / JWT
# ---------------------------------------------------------------------------
# Lifetime of access tokens (minutes).
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Lifetime of refresh tokens (days).
REFRESH_TOKEN_EXPIRE_DAYS=7
# JWT signing algorithm (HS256 is appropriate for a shared symmetric secret).
ALGORITHM=HS256

# ---------------------------------------------------------------------------
# S3 / R2-compatible object storage (deliverable assets, FF&E documentation)
# ---------------------------------------------------------------------------
# S3-compatible API endpoint. For Cloudflare R2 use:
#   https://<account>.r2.cloudflarestorage.com
# Leave as the placeholder below for a local S3 emulator (e.g. MinIO).
STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# Region for the bucket. R2 uses "auto"; AWS uses e.g. us-east-1.
STORAGE_REGION=auto
# Access credentials with read/write permissions on the bucket below.
STORAGE_ACCESS_KEY_ID=change-me
STORAGE_SECRET_ACCESS_KEY=change-me
# Bucket that stores private assets and deliverables.
STORAGE_BUCKET_NAME=pomme-studio-assets
# Public CDN/base URL used to build links to publicly served assets.
STORAGE_PUBLIC_URL=https://cdn.example.com
# Local filesystem directory for uploaded project media (brief references,
# moodboard pins). Defaults to "<repo root>/media" when commented out.
# MEDIA_ROOT=

# ---------------------------------------------------------------------------
# Google Calendar OAuth / API (availability via freebusy + Meet events)
# ---------------------------------------------------------------------------
# OAuth 2.0 client credentials from Google Cloud Console.
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me
# OAuth redirect URI registered with Google. Must match exactly.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google
# Google Cloud project that owns the OAuth client / Calendar API enablement.
GOOGLE_PROJECT_ID=change-me
# Calendar ID used for freebusy queries and event creation ("primary" = default).
GOOGLE_CALENDAR_ID=primary
# OAuth refresh token for server-side Calendar API calls. Leave empty to keep
# the integration disconnected; it is never exposed through the API.
GOOGLE_REFRESH_TOKEN=

# ---------------------------------------------------------------------------
# Studio Schedule (booking window defaults)
# ---------------------------------------------------------------------------
# IANA timezone used when displaying studio business hours to clients.
STUDIO_TIMEZONE=America/Mexico_City
# Daily business window start/end (HH:MM) for appointment booking.
STUDIO_BUSINESS_START=09:00
STUDIO_BUSINESS_END=18:00
# Default length of a discovery / intro call (minutes).
DISCOVERY_CALL_MINUTES=30
# Default length of an in-project review or survey meeting (minutes).
PROJECT_MEETING_MINUTES=60
